{
  "name": "railroad/usora",
  "type": "library",
  "description": "User management system.",
  "keywords": [
    "users",
    "management",
    "musora"
  ],
  "license": "MIT",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/railroadmedia/laravel-apidoc-generator"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "mikemclin/laravel-wp-password": "~2.0.1",
    "ext-redis": "*",
    "railroad/doctrine": "3.0.*",
    "doctrine/inflector": "^2.0",
    "doctrine/annotations": "^2.0",
    "jms/serializer": "^3.3",
    "railroad/permissions": "3.0.*",
    "php-open-source-saver/jwt-auth": "2.7.*",
    "spatie/laravel-fractal": "^6.0",
    "railroad/doctrine-array-hydrator": "2.0.*",
    "league/flysystem": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Usora\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Usora\\Tests\\": "tests/"
    }
  }
}
